	@h0 path_regexp h0 (\.html|/app-data\.json|/page-data\.json)$
	header @h0 Cache-Control "public, max-age=0, must-revalidate"
	@h1 path_regexp h1 ^(/js/.*\.js|(/.*)?/[^/]*-([^/]{32}|[^/]{20})\.(js|woff|ttf|svg|png))$
	header @h1 Cache-Control "public, max-age=172800, immutable"
	@h2 path_regexp h2 ^/styles\.[^/]{20}\.css$
	header @h2 Cache-Control "public, max-age=172800, immutable"
	@h3 path_regexp h3 ^(/misc/[^/]*\.js|/sw\.js|/python-input-sw\.js)$
	header @h3 Cache-Control "public, max-age=0, must-revalidate"
	@h4 path /manifest.webmanifest
	header @h4 Cache-Control "public, max-age=86400, stale-while-revalidate=86400, must-revalidate"
	@js path *.js
	header @js Content-Type "application/javascript; charset=utf-8"
	@json path *.json
	header @json Content-Type "application/json; charset=utf-8"
	@wm path *.webmanifest
	header @wm Content-Type "application/manifest+json; charset=utf-8"
}

